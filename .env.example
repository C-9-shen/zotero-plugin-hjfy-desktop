# Copy to .env for local development; .env is ignored by Git.
# Use forward slashes in Windows paths. These are examples, not real profiles.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=C:/Program Files/Zotero/zotero.exe

# Use a dedicated development profile and data directory.
ZOTERO_PLUGIN_PROFILE_PATH=C:/path/to/zotero-dev/profile
ZOTERO_PLUGIN_DATA_DIR=C:/path/to/zotero-dev/data

# Prevent the scaffold from closing all running Zotero processes.
# Stop your isolated development instance manually when needed.
ZOTERO_PLUGIN_KILL_COMMAND=echo Stop the isolated Zotero instance manually
MOZ_NO_REMOTE=1

# Optional local integration fixtures (see docs/development.md).
# HJFY_TEST_PDF=C:/path/to/existing.pdf
# HJFY_TEST_ARCHIVE=C:/path/to/arxiv-source.download
# HJFY_TEST_CACHE=C:/path/to/complete-translations.csv
# HJFY_TEST_DOWNLOAD=1
# HJFY_TEST_TECTONIC_ARCHIVE=C:/path/to/tectonic-0.17.0-x86_64-pc-windows-msvc.zip
# HJFY_TEST_TEX_CACHE=C:/path/to/tectonic-cache
# HJFY_TEST_LITE_BASE_URL=http://127.0.0.1:19086/v1

# Set model credentials in the plugin or desktop application, not here.
